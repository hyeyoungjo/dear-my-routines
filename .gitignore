# --- secrets: NEVER commit ---
.env
.env.*
!.env.example

# dependencies
node_modules/
# Lock file excluded: macOS-generated lock omits Linux-specific optional
# deps (e.g. @emnapi) needed by Next.js on Railway. Railway generates
# its own fresh install on Linux without a lock file present.
package-lock.json

# local-only: points npm at a corporate registry.
# only works on the office network; would break installs on home network.
.npmrc

# build output
.next/
out/
dist/
next-env.d.ts
tsconfig.tsbuildinfo

# python (harness scripts)
__pycache__/
*.pyc

# phase execution outputs
phases/**/phase*-output.json
phases/**/step*-output.json

# OS / editor
.DS_Store

# Announcement campaign files may hold excluded addresses (PII); keep only the template
/campaigns/*
!/campaigns/example.json
