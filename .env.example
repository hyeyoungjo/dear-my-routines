GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 32-byte key as 64-char hex — used to encrypt user API keys at rest (AES-256-GCM).
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64char_hex_encryption_key

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
DB_PASSWORD=your_database_password

# Feedback email (Resend)
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=your_admin_email

# Signs one-click email unsubscribe links (ADR-029). Any long random string;
# must match in every environment that mints or verifies links. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=your_unsubscribe_secret
